# ---------- Ports ----------
# Деплой (host network): Postgres на хосте, backend слушает BACKEND_PORT напрямую.
POSTGRES_PORT=5432
BACKEND_PORT=5237

# ---------- Database ----------
POSTGRES_DB=komSync
POSTGRES_USER=komsync
POSTGRES_PASSWORD=komsync

# ---------- ASP.NET ----------
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=CHANGE_ME_SUPER_SECRET_32_PLUS_CHARS
CORS_INCLUDE_BACKEND_ORIGIN=true
# Добавьте публичный URL фронта и API (например http://your-server-ip)
CORS_ALLOWED_ORIGINS=http://komsync.ru,http://www.komsync.ru,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:4200,http://localhost

# ---------- Password reset ----------
PASSWORD_RESET_FRONTEND_BASE_URL=http://komsync.ru
PASSWORD_RESET_TOKEN_LIFETIME_HOURS=24

# ---------- Reminders ----------
DEADLINE_REMINDERS_ENABLED=true
DEADLINE_REMINDERS_INTERVAL_HOURS=1
DEADLINE_REMINDERS_OFFSET_0=7
DEADLINE_REMINDERS_OFFSET_1=3
DEADLINE_REMINDERS_OFFSET_2=1
DEADLINE_REMINDERS_OFFSET_3=0

# ---------- SMTP ----------
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=komSync
SMTP_TIMEOUT_SECONDS=20

# ---------- Seed admin ----------
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@komsync.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FULLNAME=System Admin
SEED_ADMIN_DEPARTMENT=Admin
SEED_ADMIN_POSITION=Admin
